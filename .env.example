# Copy this file to .env.local. Never commit the real values.

# Persistent deployment fallback. You may instead submit a temporary key in Settings.
# A Settings key remains server-side only for the current app process/session.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key

# Server fallback/default. The Settings model list is fetched live from Google.
GEMINI_MODEL=gemini-3.7-flash

# Optional persistent fallback. You may instead configure SandboxAPI in Settings.
# Keep this server-side; never prefix it with NEXT_PUBLIC_.
SANDBOXAPI_KEY=replace_with_your_rapidapi_key
